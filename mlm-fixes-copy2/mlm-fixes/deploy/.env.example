# ---- Application ----
ENV=production
DEBUG=False
SECRET_KEY=CHANGE_ME_to_a_long_random_string_at_least_32_chars
JWT_SECRET=CHANGE_ME_another_long_random_string
SESSION_COOKIE_SECURE=True

# ---- Database (point the app at PgBouncer in production) ----
DB_HOST=127.0.0.1
DB_PORT=6432          # PgBouncer port (5432 is Postgres directly)
DB_NAME=rk_trendz_mlm
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_POOL_MIN=2
DB_POOL_MAX=20        # small per-worker pool; PgBouncer multiplexes
DB_STATEMENT_TIMEOUT_MS=5000

# ---- Redis (shared cache across all workers/servers) ----
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_DEFAULT_TIMEOUT=300

# ---- Front-end origins allowed by CORS (comma separated) ----
CORS_ORIGINS=https://app.yourdomain.com
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api

# ---- Rate limiting ----
RATELIMIT_DEFAULT=300 per minute
